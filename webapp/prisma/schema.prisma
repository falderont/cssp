// CSSP data model.
// NOTE: SQLite (the default dev datasource below) has no native enum type,
// so status/role/category fields are typed String and validated in the app
// layer (see src/lib/constants.ts) rather than as Prisma enums. Swapping the
// datasource to PostgreSQL for production does not require changing this.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Provider branding + area (location) hierarchy:
//   Region -> Country -> City -> Facility ("Site") -> Building -> Room
// This is the Global Sys Admin's master data for "where" (delegable to
// Service Desk — see requireMasterDataAdmin() in lib/session.ts), staged and
// managed from one consolidated Region/Country/City/Site screen
// (/ops/admin/facilities) that hands off to a dedicated per-site admin page
// for that site's Buildings and Rooms — see docs/prd-v7.md. A Region,
// Country or City can exist ahead of any Site actually opening there (see
// seed.ts for examples). Every facility-scoped entity in the app (incidents,
// maintenance, telemetry, visitor requests, site enrollments...) still
// points at Facility/Building directly — Country and City exist to group
// facilities geographically (reporting, delegated admin scope, tenant
// multi-location rollups) without churning every existing
// facilityId/buildingId foreign key in the app.
// ---------------------------------------------------------------------------

model ProviderSettings {
  id             String  @id @default("singleton")
  companyName    String
  logoUrl        String?
  primaryColor   String  @default("#2563eb")
  secondaryColor String  @default("#0f172a")
  supportEmail   String
  supportPhone   String
  address        String?

  // Global preferences (Global Sys Admin)
  defaultCurrency       String  @default("USD")
  defaultTimezone       String  @default("UTC")
  sessionTimeoutMinutes Int     @default(60)
  maintenanceMode       Boolean @default(false)
  maintenanceMessage    String?

  updatedAt DateTime @updatedAt
}

// Level 1 — broad geography grouping used for reporting and delegated scope
// (e.g. a CS Team member or Service Desk agent scoped to "APAC").
model Region {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  // Regions are near-static reference data (APAC, EMEA, ...) — toggled off
  // rather than deleted, so existing FK references (countries, restricted
  // users, teams) never dangle.
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  countries Country[]
  csUsers   User[]    @relation("UserRestrictedRegion")
  teams     Team[]    @relation("TeamRegion")
}

// Level 2 — ISO-3166-1 alpha-2 country code, grouped under a Region.
model Country {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // e.g. ID, MY, SG, TH, JP, HK, FI, ES
  regionId  String
  region    Region   @relation(fields: [regionId], references: [id])
  createdAt DateTime @default(now())

  cities  City[]
  csUsers User[] @relation("UserRestrictedCountry")
  teams   Team[] @relation("TeamCountry")
}

// Level 3 — a city/metro area within a Country. Facilities (Sites) sit here.
model City {
  id        String   @id @default(cuid())
  name      String
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])
  createdAt DateTime @default(now())

  facilities Facility[]

  @@unique([countryId, name])
}

// Level 4 — a "Site" in provider/tenant terminology (data center, office,
// campus). Modeled as Facility for historical reasons — see SiteEnrollment,
// which is where "site" as a tenant-facing concept is used throughout the app.
model Facility {
  id              String   @id @default(cuid())
  name            String
  code            String   @unique
  address         String?
  timezone        String   @default("UTC")
  acsEndpointUrl  String? // campus access-control system webhook; falls back to the built-in mock adapter when unset
  offersColoRacks Boolean  @default(true) // false = this site leases whole rooms only, no rack-level colocation
  cityId          String
  city            City     @relation(fields: [cityId], references: [id])
  createdAt       DateTime @default(now())

  buildings               Building[]
  siteEnrollments         SiteEnrollment[]
  incidents               Incident[]
  maintenanceEvents       MaintenanceEvent[]
  telemetrySource         TelemetrySource?
  telemetryPoints         TelemetryPoint[]
  documents               Document[]
  deliveries              Delivery[]
  restrictedUsers         User[]                  @relation("UserRestrictedFacility")
  authorizedAccessEntries AuthorizedAccessEntry[]
  teams                   Team[]                  @relation("TeamFacility")
}

// Level 5 — a building within a Site/Facility.
model Building {
  id         String   @id @default(cuid())
  name       String
  code       String
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id])
  createdAt  DateTime @default(now())

  rooms             Room[]
  incidents         Incident[]
  maintenanceEvents MaintenanceEvent[]
  telemetryPoints   TelemetryPoint[]
  visitorRequests   VisitorRequest[]
  controlledAreas   ControlledArea[]

  @@unique([facilityId, code])
}

// Level 6 — the most granular area: a room/hall/suite within a Building
// (e.g. a data hall "DH001", a mechanical/meter room "MMR", a meeting room).
// `type` distinguishes a Data Hall from an Office/Storage/Meet-Me/Other room;
// when the site offers colo racks (Facility.offersColoRacks) a Data Hall room
// can be broken down further into numbered Racks — a site that leases whole
// rooms only stops here.
model Room {
  id         String   @id @default(cuid())
  name       String
  code       String
  type       String   @default("DataHall") // DataHall/Office/Storage/MeetMeRoom/Other
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  createdAt  DateTime @default(now())

  controlledAreas ControlledArea[]
  racks           Rack[]

  @@unique([buildingId, code])
}

model Rack {
  id         String   @id @default(cuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id])
  rackNumber String
  notes      String?
  createdAt  DateTime @default(now())

  @@unique([roomId, rackNumber])
}

// ---------------------------------------------------------------------------
// Tenancy: EnterpriseAccount = a customer company; SiteEnrollment ties an
// account to one facility (an account can be enrolled at several facilities).
// ---------------------------------------------------------------------------

model EnterpriseAccount {
  id           String   @id @default(cuid())
  name         String
  legalName    String?
  tier         String   @default("Standard")
  status       String   @default("Active")
  billingEmail String?
  logoUrl      String?
  primaryColor String? // optional tenant brand accent shown in their portal
  createdAt    DateTime @default(now())

  users                   User[]
  siteEnrollments         SiteEnrollment[]
  documents               Document[]
  invoices                Invoice[]
  engagementLogs          EngagementLog[]
  deliveries              Delivery[]
  authorizedAccessEntries AuthorizedAccessEntry[]
}

// One row per facility a tenant occupies — an account with several
// SiteEnrollments is a tenant with multiple locations. `spaceRef` remains a
// free-text summary (e.g. "Suite 4, Rack Row 12"); ControlledArea below adds
// the structured version, scoping the enrollment down to specific
// buildings/rooms when the tenant's contractual footprint needs that detail.
model SiteEnrollment {
  id                  String            @id @default(cuid())
  enterpriseAccountId String
  enterpriseAccount   EnterpriseAccount @relation(fields: [enterpriseAccountId], references: [id])
  facilityId          String
  facility            Facility          @relation(fields: [facilityId], references: [id])
  status              String            @default("Active")
  spaceRef            String?
  createdAt           DateTime          @default(now())

  visitorRequests VisitorRequest[]
  serviceRequests ServiceRequest[]
  controlledAreas ControlledArea[]

  @@unique([enterpriseAccountId, facilityId])
}

// A tenant's controlled/leased area within one enrolled site — as granular
// as a single Room, or as broad as a whole Building. A SiteEnrollment can
// have several (e.g. a cage in Building A plus a dedicated meeting room).
model ControlledArea {
  id               String         @id @default(cuid())
  siteEnrollmentId String
  siteEnrollment   SiteEnrollment @relation(fields: [siteEnrollmentId], references: [id])
  buildingId       String?
  building         Building?      @relation(fields: [buildingId], references: [id])
  roomId           String?
  room             Room?          @relation(fields: [roomId], references: [id])
  label            String // e.g. "Suite 4B" — shown even when building/room aren't set
  accessNotes      String?
  createdAt        DateTime       @default(now())
}

model User {
  id                   String             @id @default(cuid())
  name                 String
  email                String             @unique
  passwordHash         String
  role                 String
  csScope              String? // Corporate/Region/Country/Site/Billing — only when role = CS_TEAM
  title                String?
  phone                String?
  avatarUrl            String?
  isActive             Boolean            @default(true)

  // Personal UI customization — chrome-only preferences, scoped to this
  // user's own view (not tenant/provider branding). accentColor overrides
  // --brand-primary when set; mutedNotificationCategories is a comma
  // separated list of Notification.category values the user no longer
  // wants surfaced in the notifications balloon/list.
  accentColor                String?
  density                    String  @default("comfortable")
  mutedNotificationCategories String @default("")
  enterpriseAccountId  String?
  enterpriseAccount    EnterpriseAccount? @relation(fields: [enterpriseAccountId], references: [id])
  restrictedFacilityId String?
  restrictedFacility   Facility?          @relation("UserRestrictedFacility", fields: [restrictedFacilityId], references: [id])
  restrictedRegionId   String?
  restrictedRegion     Region?            @relation("UserRestrictedRegion", fields: [restrictedRegionId], references: [id])
  restrictedCountryId  String?
  restrictedCountry    Country?           @relation("UserRestrictedCountry", fields: [restrictedCountryId], references: [id])
  teamId               String?
  team                 Team?              @relation("TeamMembers", fields: [teamId], references: [id])
  createdAt            DateTime           @default(now())

  hostedVisitorRequests   VisitorRequest[]        @relation("HostUser")
  createdVisitorRequests  VisitorRequest[]        @relation("CreatedByUser")
  createdIncidents        Incident[]              @relation("IncidentCreatedBy")
  incidentUpdates         IncidentUpdate[]
  uploadedIncidentReports Incident[]              @relation("IncidentReportUploadedBy")
  createdMaintenance      MaintenanceEvent[]      @relation("MaintenanceCreatedBy")
  createdServiceRequests  ServiceRequest[]        @relation("SRCreatedBy")
  assignedServiceRequests ServiceRequest[]        @relation("SRAssignedTo")
  publishedDocuments      Document[]              @relation("DocPublishedBy")
  engagementLogs          EngagementLog[]         @relation("EngagementRep")
  notifications           Notification[]
  createdBlacklistEntries BlacklistEntry[]        @relation("BlacklistCreatedBy")
  loggedDeliveries        Delivery[]              @relation("DeliveryLoggedBy")
  receivedDeliveries      Delivery[]              @relation("DeliveryReceivedBy")
  requestedAalEntries     AuthorizedAccessEntry[] @relation("AalRequestedBy")
  decidedAalEntries       AuthorizedAccessEntry[] @relation("AalDecidedBy")
  auditLogs               AuditLog[]
  backups                 BackupRecord[]
  requestedAreaChanges    AreaChangeRequest[]     @relation("AreaChangeRequestedBy")
  assignedAreaChanges     AreaChangeRequest[]     @relation("AreaChangeAssignedTo")
  decidedAreaChanges      AreaChangeRequest[]     @relation("AreaChangeDecidedBy")
}

// ---------------------------------------------------------------------------
// Visitor management (single + group/batch) + campus ACS integration stub
// ---------------------------------------------------------------------------

model VisitorRequest {
  id               String         @id @default(cuid())
  siteEnrollmentId String
  siteEnrollment   SiteEnrollment @relation(fields: [siteEnrollmentId], references: [id])
  buildingId       String?
  building         Building?      @relation(fields: [buildingId], references: [id])
  purpose          String
  visitDate        DateTime
  windowStart      String
  windowEnd        String
  isGroup          Boolean        @default(false)
  source           String         @default("Single") // Single/Batch
  hostUserId       String?
  hostUser         User?          @relation("HostUser", fields: [hostUserId], references: [id])
  createdById      String
  createdByUser    User           @relation("CreatedByUser", fields: [createdById], references: [id])
  acsSyncStatus    String         @default("NotSynced") // NotSynced/Synced/Failed
  createdAt        DateTime       @default(now())

  visitors Visitor[]
  acsLogs  AcsIntegrationLog[]
}

model Visitor {
  id                String         @id @default(cuid())
  visitorRequestId  String
  visitorRequest    VisitorRequest @relation(fields: [visitorRequestId], references: [id])
  fullName          String
  idType            String?
  idNumber          String?
  company           String?
  email             String?
  phone             String?
  status            String         @default("Pending") // Pending/Blacklisted/Approved/Denied/CheckedIn/CheckedOut
  badgeCode         String?
  checkedInAt       DateTime?
  checkedOutAt      DateTime?
  verificationToken String         @unique @default(cuid())
  isBlacklistMatch  Boolean        @default(false)
  blacklistReason   String?
  createdAt         DateTime       @default(now())
}

// Provider-maintained watchlist checked automatically against every incoming
// visitor (by name and/or ID number) before it reaches the ops approval
// queue — the "first layer" ahead of manual review.
model BlacklistEntry {
  id          String   @id @default(cuid())
  fullName    String
  idNumber    String?
  company     String?
  reason      String
  createdById String
  createdBy   User     @relation("BlacklistCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// Incoming logistics / courier deliveries — a customer-submitted request
// ticket into the VMS, the same pattern as VisitorRequest: the tenant is
// the only one who can create one (via the portal); ops only processes it
// through to arrival/hand-off (or rejects it). See actions/deliveries.ts.
model Delivery {
  id                  String            @id @default(cuid())
  facilityId          String
  facility            Facility          @relation(fields: [facilityId], references: [id])
  enterpriseAccountId String
  enterpriseAccount   EnterpriseAccount @relation(fields: [enterpriseAccountId], references: [id])
  courierName         String
  trackingNumber      String?
  description         String
  recipientName       String?
  expectedAt          DateTime?
  status              String            @default("Expected") // Expected/Arrived/Received/Rejected
  arrivedAt           DateTime?
  receivedAt          DateTime?
  receivedById        String?
  receivedBy          User?             @relation("DeliveryReceivedBy", fields: [receivedById], references: [id])
  notes               String?
  createdById         String
  createdBy           User              @relation("DeliveryLoggedBy", fields: [createdById], references: [id])
  createdAt           DateTime          @default(now())
}

model AcsIntegrationLog {
  id               String         @id @default(cuid())
  visitorRequestId String
  visitorRequest   VisitorRequest @relation(fields: [visitorRequestId], references: [id])
  endpointUrl      String
  requestPayload   String
  responseStatus   Int
  responseBody     String
  createdAt        DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// Incidents + maintenance (both facility/building scoped, customer-visible)
// ---------------------------------------------------------------------------

model Incident {
  id                String    @id @default(cuid())
  facilityId        String
  facility          Facility  @relation(fields: [facilityId], references: [id])
  buildingId        String?
  building          Building? @relation(fields: [buildingId], references: [id])
  title             String
  description       String
  category          String    @default("Other") // Electrical/Mechanical/Building/Fire/Security/Network/Other
  impactedServices  String    @default("[]") // JSON string array, e.g. ["Power","Cooling"] - see lib/constants.ts
  locationDetail    String? // free-text granular location, e.g. "Floor 2, Server Hall B, Row 12"
  severity          String    @default("P3") // P1/P2/P3/P4
  status            String    @default("Investigating") // Investigating/Identified/Monitoring/Resolved
  isCustomerVisible Boolean   @default(true)
  startedAt         DateTime
  resolvedAt        DateTime?
  createdById       String
  createdByUser     User      @relation("IncidentCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime  @default(now())

  reportFileName     String?
  reportStorageKey   String?
  reportUploadedById String?
  reportUploadedBy   User?     @relation("IncidentReportUploadedBy", fields: [reportUploadedById], references: [id])
  reportUploadedAt   DateTime?

  updates IncidentUpdate[]
}

model IncidentUpdate {
  id            String   @id @default(cuid())
  incidentId    String
  incident      Incident @relation(fields: [incidentId], references: [id])
  message       String
  createdById   String
  createdByUser User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
}

model MaintenanceEvent {
  id            String    @id @default(cuid())
  facilityId    String
  facility      Facility  @relation(fields: [facilityId], references: [id])
  buildingId    String?
  building      Building? @relation(fields: [buildingId], references: [id])
  title         String
  description   String
  maintType     String    @default("Planned") // Planned/Emergency
  impact        String    @default("NoImpact") // NoImpact/RedundancyReduced/FullOutage
  startAt       DateTime
  endAt         DateTime
  status        String    @default("Scheduled") // Scheduled/InProgress/Completed/Cancelled
  createdById   String
  createdByUser User      @relation("MaintenanceCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())

  notifications MaintenanceNotification[]
}

model MaintenanceNotification {
  id                 String           @id @default(cuid())
  maintenanceEventId String
  maintenanceEvent   MaintenanceEvent @relation(fields: [maintenanceEventId], references: [id])
  channel            String           @default("IN_APP") // IN_APP/EMAIL
  audience           String
  message            String
  sentAt             DateTime         @default(now())
}

// ---------------------------------------------------------------------------
// Service Requests — the single unified module for Complaints, RFIs, general
// service requests (site walk/escort, meetings, etc.) AND Remote/Smart Hands.
// Remote Hands is a *category* here, not a separate entity: it shares the
// same queue, assignment and status lifecycle as every other request, and
// only uses the remote-hands-specific fields (assetRef, taskType, time
// tracking, billable minutes, completion proof, sign-off) when relevant.
// ---------------------------------------------------------------------------

model ServiceRequest {
  id               String         @id @default(cuid())
  siteEnrollmentId String
  siteEnrollment   SiteEnrollment @relation(fields: [siteEnrollmentId], references: [id])

  category    String // Complaint/RFI/RemoteHands/SiteWalkEscort/GeneralMeeting/Other
  subject     String
  description String
  priority    String @default("Normal") // Low/Normal/High/Urgent
  status      String @default("Submitted") // Submitted/Accepted/InProgress/Done/Cancelled

  createdById    String
  createdByUser  User    @relation("SRCreatedBy", fields: [createdById], references: [id])
  assignedToId   String?
  assignedToUser User?   @relation("SRAssignedTo", fields: [assignedToId], references: [id])

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  // Scheduling — used by SiteWalkEscort/GeneralMeeting (a calendar entry to
  // export to Outlook) and as the requested window for RemoteHands.
  scheduledStart DateTime?
  scheduledEnd   DateTime?

  // Remote / Smart Hands fields (only populated when category = RemoteHands)
  taskType           String?
  assetRef           String?
  startedAt          DateTime?
  completedAt        DateTime?
  billableMinutes    Int?
  completionNotes    String?
  completionPhotoUrl String?

  // Customer sign-off / acceptance (captured once a RemoteHands request is
  // Done) — the generated PDF doubles as the document attached for billing.
  signOffName          String?
  signOffTitle         String?
  signOffSignedAt      DateTime?
  signOffPdfStorageKey String?

  csatRating String?
}

// ---------------------------------------------------------------------------
// BMS telemetry (optional per-facility integration, read-only mirror)
// ---------------------------------------------------------------------------

model TelemetrySource {
  id         String    @id @default(cuid())
  facilityId String    @unique
  facility   Facility  @relation(fields: [facilityId], references: [id])
  vendor     String?
  status     String    @default("NotConfigured") // NotConfigured/Connected/Error
  lastSyncAt DateTime?
}

model TelemetryPoint {
  id         String    @id @default(cuid())
  facilityId String
  facility   Facility  @relation(fields: [facilityId], references: [id])
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id])
  metric     String // TEMP_C/HUMIDITY_PCT/POWER_KW/PUE
  value      Float
  recordedAt DateTime

  @@index([facilityId, metric, recordedAt])
}

// ---------------------------------------------------------------------------
// Reporting / download center
// ---------------------------------------------------------------------------

model Document {
  id                  String             @id @default(cuid())
  enterpriseAccountId String?
  enterpriseAccount   EnterpriseAccount? @relation(fields: [enterpriseAccountId], references: [id])
  facilityId          String?
  facility            Facility?          @relation(fields: [facilityId], references: [id])
  title               String
  category            String // SLAReport/Invoice/Compliance/Contract/SiteIntroduction/TermsConditions/Other
  fileName            String
  storageKey          String
  mimeType            String
  fileSizeKb          Int
  publishedById       String
  publishedByUser     User               @relation("DocPublishedBy", fields: [publishedById], references: [id])
  publishedAt         DateTime           @default(now())
}

// ---------------------------------------------------------------------------
// Billing / invoicing
// ---------------------------------------------------------------------------

model Invoice {
  id                  String            @id @default(cuid())
  enterpriseAccountId String
  enterpriseAccount   EnterpriseAccount @relation(fields: [enterpriseAccountId], references: [id])
  invoiceNumber       String            @unique
  periodStart         DateTime
  periodEnd           DateTime
  issueDate           DateTime
  dueDate             DateTime
  status              String            @default("Draft") // Draft/Sent/Paid/Overdue
  currency            String            @default("USD")
  subtotal            Float
  tax                 Float
  total               Float
  notes               String?
  createdAt           DateTime          @default(now())

  lineItems InvoiceLineItem[]
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  category    String // Space/Power/CrossConnect/RemoteHands/Other
  quantity    Float   @default(1)
  unitPrice   Float
  amount      Float
}

// ---------------------------------------------------------------------------
// Internal CS engagement + team performance (computed from this + ServiceRequest)
// ---------------------------------------------------------------------------

model EngagementLog {
  id                     String            @id @default(cuid())
  enterpriseAccountId    String
  enterpriseAccount      EnterpriseAccount @relation(fields: [enterpriseAccountId], references: [id])
  repId                  String
  rep                    User              @relation("EngagementRep", fields: [repId], references: [id])
  type                   String // call/email/meeting/site_visit/service_request
  notes                  String
  occurredAt             DateTime          @default(now())
  linkedServiceRequestId String?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  category  String // incident/maintenance/visitor/service_request/billing/delivery
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Authorized Access List (AAL) — permanent, undated site access for a named
// person (contractor, long-term staff), distinct from a one-off dated
// VisitorRequest. Requested by the tenant, decided by ops for that facility.
// ---------------------------------------------------------------------------

model AuthorizedAccessEntry {
  id                  String            @id @default(cuid())
  enterpriseAccountId String
  enterpriseAccount   EnterpriseAccount @relation(fields: [enterpriseAccountId], references: [id])
  facilityId          String
  facility            Facility          @relation(fields: [facilityId], references: [id])
  fullName            String
  idType              String?
  idNumber            String?
  company             String?
  accessLevel         String            @default("Standard") // Standard/Escorted/FullAccess
  reason              String
  validFrom           DateTime          @default(now())
  validUntil          DateTime?
  status              String            @default("PendingApproval") // PendingApproval/Active/Rejected/Revoked
  requestedById       String
  requestedBy         User              @relation("AalRequestedBy", fields: [requestedById], references: [id])
  decidedById         String?
  decidedBy           User?             @relation("AalDecidedBy", fields: [decidedById], references: [id])
  decidedAt           DateTime?
  decisionNotes       String?
  createdAt           DateTime          @default(now())
}

// ---------------------------------------------------------------------------
// Area (location) master data is owned by the Global Sys Admin and may be
// delegated to Service Desk (see requireMasterDataAdmin() in lib/session.ts).
// Any other internal staff who need a change (new site, renamed building,
// new room, etc.) raise one of these instead of editing master data
// directly — the ticket a Sys Admin/Service Desk agent triages and applies.
// ---------------------------------------------------------------------------

model AreaChangeRequest {
  id            String    @id @default(cuid())
  level         String // Region/Country/City/Site/Building/Room
  action        String    @default("Add") // Add/Update/Deactivate
  context       String // free-text location, e.g. "Indonesia > Batam > NDP > Building A"
  proposedName  String?
  proposedCode  String?
  notes         String
  status        String    @default("Submitted") // Submitted/InReview/Approved/Rejected/Applied
  requestedById String
  requestedBy   User      @relation("AreaChangeRequestedBy", fields: [requestedById], references: [id])
  assignedToId  String?
  assignedTo    User?     @relation("AreaChangeAssignedTo", fields: [assignedToId], references: [id])
  decidedById   String?
  decidedBy     User?     @relation("AreaChangeDecidedBy", fields: [decidedById], references: [id])
  decisionNotes String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Teams — the Global Sys Admin's organizational master data: a named roster
// of internal staff scoped to exactly one level of the geography (a whole
// region, one country, or a single facility) or left unscoped for a
// company-wide/global team. Distinct from a user's individual facility/
// region restriction: a team is the reporting/coverage unit a Global Sys
// Admin defines up front, not an ad hoc grouping of whoever happens to
// share a scope.
// ---------------------------------------------------------------------------

model Team {
  id         String    @id @default(cuid())
  name       String
  function   String // Ops/NOC/Security/CustomerSuccess/ServiceDesk/Facilities/Executive — see lib/constants.ts
  regionId   String?
  region     Region?   @relation("TeamRegion", fields: [regionId], references: [id])
  countryId  String?
  country    Country?  @relation("TeamCountry", fields: [countryId], references: [id])
  facilityId String?
  facility   Facility? @relation("TeamFacility", fields: [facilityId], references: [id])
  createdAt  DateTime  @default(now())

  members User[] @relation("TeamMembers")
}

// ---------------------------------------------------------------------------
// Global Sys Admin control plane: integrations, audit log, backups.
// ---------------------------------------------------------------------------

model SystemIntegration {
  id         String    @id @default(cuid())
  key        String    @unique // ACS/DCIM/BMS/SSO/EMAIL
  name       String
  status     String    @default("NotConfigured") // NotConfigured/Connected/Error/Disabled
  configJson String? // free-form mock config, e.g. { "endpoint": "..." }
  lastSyncAt DateTime?
  updatedAt  DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String // e.g. user.create, tenant.create, branding.update, backup.create
  targetType String?
  targetId   String?
  summary    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model BackupRecord {
  id          String   @id @default(cuid())
  fileName    String
  storageKey  String
  fileSizeKb  Int
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}
