# Copy this file to .env and adjust as needed.

# SQLite is used out of the box for a zero-install local demo.
# For production, swap to PostgreSQL (see README "Going to production").
DATABASE_URL="file:./dev.db"

# Generate a real secret for anything beyond local demo use:
#   openssl rand -base64 32
NEXTAUTH_SECRET="dev-only-insecure-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"
