# Migration/owner connection (DDL rights) — used by `prisma migrate` and the seed script.
DATABASE_URL="postgresql://cssp:cssp_dev_password@localhost:5432/cssp?schema=public"

# Runtime application connection — a role WITHOUT owner/superuser privileges, so
# Postgres row-level security (prisma/rls.sql) actually applies to it. The app's
# PrismaClient (lib/db.ts) always connects with this, never with DATABASE_URL above.
APP_DATABASE_URL="postgresql://cssp_app:cssp_app_password@localhost:5432/cssp?schema=public"

# Symmetric secret used to sign session cookies (lib/auth). Generate a real random
# value for any non-local environment.
AUTH_SECRET="change-me"
